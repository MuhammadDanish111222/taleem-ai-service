APP_NAME=Taleem AI Service
APP_ENV=development
FIREBASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taleem_dev
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
EMBEDDING_DIM=768
# Required for every worker process.  Use local_admin only on the owner's
# machine; Railway must use railway_public and can never claim bulk embeddings.
WORKER_MODE=local_admin
