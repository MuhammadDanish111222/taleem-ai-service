APP_NAME=Taleem AI Service
APP_ENV=development
# Process role: 'api' for FastAPI web server, 'worker' for background job runtime
TALEEM_PROCESS_ROLE=api
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_JWT_PUBLIC_KEYS_JSON={}
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=2400
DEEPSEEK_MAX_INPUT_CHARACTERS=32000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taleem_dev
REDIS_URL=redis://localhost:6379/0
# Production must use the shared remote provider's TLS URL (normally rediss://).
ACTIVE_CORPUS_CACHE_TTL_SECONDS=300
USAGE_POLICY_CACHE_TTL_SECONDS=300
PROMPT_CACHE_TTL_SECONDS=300
# Required secrets. Use independent, randomly generated values outside local tests.
USAGE_UID_HMAC_SECRET=
INTERNAL_JTI_HMAC_SECRET=
BUSINESS_TIMEZONE=Asia/Karachi

# Voyage AI Embeddings Configuration
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_MODEL_REVISION=voyage-4-lite-512-v1
EMBEDDING_DIM=512
EMBEDDING_OUTPUT_DTYPE=float
VOYAGE_EMBED_BATCH_SIZE=64
# Separate credentials: Local Admin uses VOYAGE_ADMIN_API_KEY; Railway production uses VOYAGE_API_KEY
VOYAGE_ADMIN_API_KEY=
VOYAGE_API_KEY=

# Google Gemini Vision OCR Configuration
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.6-flash

# Required for every worker process (when TALEEM_PROCESS_ROLE=worker).
# Use local_admin on owner machine for bulk embeddings; Railway must use railway_public.
WORKER_MODE=local_admin

# Multiple Ask Configuration
MULTIPLE_ASK_RUN1_ENABLED=false
MULTIPLE_ASK_ANSWER_BATCH_SIZE=5
MULTIPLE_ASK_TEMPORARY_BUCKET=multiple-ask-temporary
MULTIPLE_ASK_SESSION_TTL_SECONDS=900
MULTIPLE_ASK_RAW_SOURCE_RETENTION_HOURS=24
MULTIPLE_ASK_JOB_RETENTION_DAYS=7
MULTIPLE_ASK_MAX_IMAGE_BYTES=8388608
MULTIPLE_ASK_MAX_PDF_BYTES=15728640
MULTIPLE_ASK_MAX_TEXT_CHARACTERS=30000
MULTIPLE_ASK_MAX_PDF_PAGES=10
MULTIPLE_ASK_MAX_IMAGE_PIXELS=20000000
MULTIPLE_ASK_MAX_PDF_EXTRACTED_CHARACTERS=30000
MULTIPLE_ASK_MAX_EXTRACTED_QUESTIONS=60
MULTIPLE_ASK_MAX_RENDERED_PDF_PAGE_PIXELS=12000000
MULTIPLE_ASK_CLEANUP_BATCH_SIZE=100
MULTIPLE_ASK_CLEANUP_INTERVAL_SECONDS=300
