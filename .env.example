APP_NAME=Taleem AI Service
APP_ENV=development
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_JWT_PUBLIC_KEYS_JSON={}
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=1600
DEEPSEEK_MAX_INPUT_CHARACTERS=32000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taleem_dev
REDIS_URL=redis://localhost:6379/0
# Production must use the shared remote provider's TLS URL (normally rediss://).
ACTIVE_CORPUS_CACHE_TTL_SECONDS=300
USAGE_POLICY_CACHE_TTL_SECONDS=300
PROMPT_CACHE_TTL_SECONDS=300
# Required secrets. Use independent, randomly generated values outside local tests.
USAGE_UID_HMAC_SECRET=
INTERNAL_JTI_HMAC_SECRET=
BUSINESS_TIMEZONE=Asia/Karachi
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
EMBEDDING_DIM=768
# Optional override. Railway public mode defaults to low-memory ONNX; local admin defaults to Torch.
BGE_INFERENCE_RUNTIME=
# Required for every worker process.  Use local_admin only on the owner's
# machine; Railway must use railway_public and can never claim bulk embeddings.
WORKER_MODE=local_admin
